{
  "manifest_version": 3,
  "name": "YouTube / Bilibili 本机下载",
  "version": "0.3.4",
  "description": "在 YouTube 或 Bilibili 视频下方选择清晰度，直接在浏览器内下载并合并音视频。",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "offscreen",
    "scripting",
    "activeTab",
    "webRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://www.bilibili.com/*",
    "https://m.bilibili.com/*",
    "https://bilibili.com/*",
    "https://space.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://upos-hz-mirrorakam.akamaized.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "YouTube / Bilibili 本机下载"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.bilibili.com/*",
        "https://m.bilibili.com/*",
        "https://bilibili.com/*",
        "https://space.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self' https://www.youtube.com https://m.youtube.com https://api.bilibili.com https://*.googlevideo.com https://*.bilivideo.com https://*.bilivideo.cn https://upos-hz-mirrorakam.akamaized.net; worker-src 'self'"
  }
}
