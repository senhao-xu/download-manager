# Runtime configuration. Copy to .env or set in docker-compose.yml.
# NOTE: cookies + proxy for YouTube are configured inline in the YouTube tab,
# and Bilibili cookies in the Bilibili tab, persisted to DATA_DIR. The vars
# below are optional fallbacks.

# Server
PORT=8000
DATA_DIR=/data
DOWNLOAD_DIR=/data/downloads
TTL_MINUTES=60
MAX_CONCURRENT=3

# YouTube access (optional fallbacks; prefer the Settings UI)
# YTDLP_COOKIEFILE=/data/cookies.txt   # cookies.txt from a logged-in browser
# YTDLP_PROXY=http://127.0.0.1:7890     # HTTP/SOCKS proxy to reach YouTube
# YTDLP_IMPERSONATE=chrome              # only if curl_cffi browser support is available
# YTDLP_SLEEP_INTERVAL=0

# Bilibili access (optional fallback; prefer the Bilibili tab Settings UI)
# YTDLP_BILIBILI_COOKIEFILE=/data/bilibili_cookies.txt  # SESSDATA etc. (1080P+/member content)
